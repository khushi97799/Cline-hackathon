{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "SchemeRule",
  "type": "object",
  "required": ["scheme_id", "state", "version", "status", "verified", "effective_from", "review_by", "source", "conditions"],
  "properties": {
    "scheme_id": { "type": "string" },
    "state": { "type": "string", "description": "State code or ALL for national" },
    "version": { "type": "integer", "minimum": 1 },
    "status": { "type": "string", "enum": ["draft", "in_review", "approved", "needs_update", "rejected"] },
    "verified": { "type": "boolean" },
    "effective_from": { "type": "string", "format": "date" },
    "review_by": { "type": "string", "format": "date" },
    "source": {
      "type": "object",
      "required": ["url", "page", "clause", "exact_quote"],
      "properties": {
        "url": { "type": "string" },
        "page": { "type": ["string", "integer"] },
        "clause": { "type": "string" },
        "exact_quote": { "type": "string" }
      }
    },
    "conditions": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["field", "op", "value", "type", "source"],
        "properties": {
          "field": { "type": "string" },
          "op": { "type": "string", "enum": ["=", "!=", "<", "<=", ">", ">=", "in"] },
          "value": {},
          "type": { "type": "string", "enum": ["hard", "ambiguous"] },
          "note": { "type": "string" },
          "source": {
            "type": "object",
            "required": ["url", "page", "clause", "exact_quote"],
            "properties": {
              "url": { "type": "string" },
              "page": { "type": ["string", "integer"] },
              "clause": { "type": "string" },
              "exact_quote": { "type": "string" }
            }
          }
        }
      }
    }
  }
}
