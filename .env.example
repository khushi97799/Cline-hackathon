# Copy this file to .env and fill in real values. Never commit the real .env.

# development | production. In production the TEST OTP provider is refused
# and JWT_SECRET is mandatory.
APP_ENV=development

# Database (SQLite default locally; set a Postgres URL in production)
DATABASE_URL=sqlite:///./scheme_sniper.db

# Auth: use a long random string, e.g.  python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=

# Comma-separated phone numbers allowed to sign in as the FIRST admin.
# After that, admins add CSC operators from the Admin dashboard.
ADMIN_PHONES=

# ---- OTP delivery: test | twilio | msg91 ----
OTP_PROVIDER=test
TEST_OTP_CODE=123456
OTP_COUNTRY_CODE=+91

# Twilio (OTP_PROVIDER=twilio)
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=

# MSG91 (OTP_PROVIDER=msg91). India needs a DLT-approved template.
MSG91_AUTH_KEY=
MSG91_TEMPLATE_ID=

# Vision model for document field extraction (never used to decide eligibility)
VISION_API_KEY=
VISION_API_URL=https://api.openai.com/v1/chat/completions
VISION_MODEL=gpt-4o-mini

# LLM used ONLY to draft rule JSON from admin-provided source text.
RULE_DRAFTING_LLM_API_KEY=
RULE_DRAFTING_LLM_MODEL=gpt-4o-mini

# Daily source-refresh job schedule (24h HH:MM, server local time)
DAILY_REFRESH_TIME=03:00
DAILY_REFRESH_TOKEN=change-me
